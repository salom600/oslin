#!/bin/sh
set -e
echo "[OSLin] Setting up Sway Wayland desktop..."

# Copy Sway config
mkdir -p /etc/sway
cp /etc/oslin/sway/config /etc/sway/config
chmod 644 /etc/sway/config
mkdir -p /etc/sway/config.d

# Copy Waybar config
mkdir -p /etc/xdg/waybar
cp /etc/oslin/waybar/config /etc/xdg/waybar/config
cp /etc/oslin/waybar/style.css /etc/xdg/waybar/style.css

# Copy Wofi config
mkdir -p /etc/xdg/wofi
cp /etc/oslin/wofi/config /etc/xdg/wofi/config
cp /etc/oslin/wofi/style.css /etc/xdg/wofi/style.css

# Copy to user skeleton
mkdir -p /etc/skel/.config/sway /etc/skel/.config/waybar /etc/skel/.config/wofi
cp /etc/sway/config /etc/skel/.config/sway/config
cp /etc/oslin/waybar/config /etc/skel/.config/waybar/config
cp /etc/oslin/waybar/style.css /etc/skel/.config/waybar/style.css
cp /etc/oslin/wofi/config /etc/skel/.config/wofi/config
cp /etc/oslin/wofi/style.css /etc/skel/.config/wofi/style.css

# Copy to live user
if [ -d /home/oslin ]; then
    mkdir -p /home/oslin/.config/sway /home/oslin/.config/waybar /home/oslin/.config/wofi
    cp /etc/sway/config /home/oslin/.config/sway/config
    cp /etc/oslin/waybar/config /home/oslin/.config/waybar/config
    cp /etc/oslin/waybar/style.css /home/oslin/.config/waybar/style.css
    cp /etc/oslin/wofi/config /home/oslin/.config/wofi/config
    cp /etc/oslin/wofi/style.css /home/oslin/.config/wofi/style.css
    chown -R oslin:oslin /home/oslin/.config
fi

# Create sway session entries
mkdir -p /usr/share/wayland-sessions /usr/share/xsessions
cat > /usr/share/wayland-sessions/sway.desktop <<'EOF'
[Desktop Entry]
Name=OSLin (Sway)
Comment=OSLin modern Wayland desktop
Exec=sway
Type=Application
DesktopNames=OSLin;Sway;Wayland
EOF
cp /usr/share/wayland-sessions/sway.desktop /usr/share/xsessions/sway.desktop

# Set Sway as default session
if [ -f /etc/lightdm/lightdm.conf ]; then
    sed -i 's/^user-session=.*/user-session=sway/' /etc/lightdm/lightdm.conf 2>/dev/null || true
    sed -i 's/^autologin-session=.*/autologin-session=sway/' /etc/lightdm/lightdm.conf 2>/dev/null || true
fi

# Remove XFCE session entries
rm -f /usr/share/xsessions/xfce.desktop /usr/share/wayland-sessions/xfce.desktop 2>/dev/null || true

# Add oslin to required groups
if id oslin >/dev/null 2>&1; then
    usermod -aG video oslin 2>/dev/null || true
    usermod -aG input oslin 2>/dev/null || true
    usermod -aG render oslin 2>/dev/null || true
    usermod -aG seat oslin 2>/dev/null || true
fi

# Pictures dir
mkdir -p /etc/skel/Pictures
[ -d /home/oslin ] && mkdir -p /home/oslin/Pictures && chown oslin:oslin /home/oslin/Pictures

# Wayland environment
cat > /etc/profile.d/oslin-wayland.sh <<'EOF'
export XDG_SESSION_TYPE=wayland
export XDG_CURRENT_DESKTOP=sway
export QT_QPA_PLATFORM=wayland
export QT_WAYLAND_DISABLE_WINDOWDECORATION=1
export GDK_BACKEND=wayland
export CLUTTER_BACKEND=wayland
export SDL_VIDEODRIVER=wayland
export MOZ_ENABLE_WAYLAND=1
export _JAVA_AWT_WM_NONREPARENTING=1
EOF
chmod 644 /etc/profile.d/oslin-wayland.sh

systemctl enable seatd.service 2>/dev/null || true
echo "[OSLin] Sway desktop setup complete."
exit 0
