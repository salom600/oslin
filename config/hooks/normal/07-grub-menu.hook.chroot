#!/bin/sh
# ============================================
# OSLin - Hook: 07-grub-menu.chroot
# Enable visible GRUB boot menu + custom OSLin GRUB theme
# ============================================
set +e  # tolerant mode for chroot build

echo "[OSLin] Configuring GRUB boot menu..."

# ---------- /etc/default/grub ----------
# Show menu for 5 seconds, custom theme, custom colors
cat > /etc/default/grub <<'EOF'
# OSLin GRUB configuration
# Generated by oslin build system

# Boot menu visible for 5 seconds (user can pick / edit)
GRUB_TIMEOUT=5
GRUB_TIMEOUT_STYLE=menu

# Default to first entry
GRUB_DEFAULT=0
GRUB_SAVEDEFAULT=false

# Show the menu, don't hide it
GRUB_HIDDEN_TIMEOUT=
GRUB_HIDDEN_TIMEOUT_QUIET=false

# Background image + colors (used if theme fails)
GRUB_BACKGROUND="/boot/grub/themes/oslin/background.png"

# Colors: blue + white (OSLin brand)
GRUB_COLOR_NORMAL="white/black"
GRUB_COLOR_HIGHLIGHT="light-blue/black"

# Linux command line (quiet boot after menu)
GRUB_CMDLINE_LINUX_DEFAULT="quiet splash"
GRUB_CMDLINE_LINUX=""

# Distribution
GRUB_DISTRIBUTOR="OSLin"

# Disable submenus (flat menu, easier for users)
GRUB_DISABLE_SUBMENU=y

# Don't probe for other OSes by default (faster boot)
# (Users can run `os-prober` manually if dual-booting)
GRUB_DISABLE_OS_PROBER=true

# Recovery mode entries
GRUB_DISABLE_RECOVERY=false

# Use UUID in fstab (more reliable than /dev/sdX)
GRUB_DISABLE_LINUX_UUID=false
GRUB_DISABLE_LINUX_PARTUUID=false

# GFX mode
GRUB_GFXMODE=auto
GRUB_GFXPAYLOAD_LINUX=keep

# Terminal
GRUB_TERMINAL=console

# Theme
GRUB_THEME="/boot/grub/themes/oslin/theme.txt"

# Allow booting from serial console too
#GRUB_TERMINAL="console serial"
#GRUB_SERIAL_COMMAND="serial --speed=115200"
EOF

# ---------- Create OSLin GRUB theme ----------
THEME_DIR="/boot/grub/themes/oslin"
mkdir -p "$THEME_DIR"

# Theme definition
cat > "$THEME_DIR/theme.txt" <<'EOF'
# OSLin GRUB Theme
# Modern blue gradient with macOS/Windows 11 vibe

# General
title-text: "OSLin 2026.1 Aurora"
title-font: "Noto Sans Bold 24"
title-color: "#FFFFFF"
message-font: "Noto Sans 14"
message-color: "#FFFFFF"
message-bg-color: "#0A2540"

# Background
desktop-color: "#0A2540"
desktop-image: "background.png"

# Boot menu (centered)
+ boot_menu {
    left = 25%
    top = 30%
    width = 50%
    height = 40%
    item_font = "Noto Sans 18"
    item_color = "#E3F2FD"
    selected_item_color = "#FFFFFF"
    selected_item_pixmap_style = "highlight_*.png"
    item_height = 36
    item_spacing = 8
    icon_width = 32
    icon_height = 32
    item_icon_space = 12
    item_pixmap_style = "bullet_*.png"
}

# Progress bar at bottom
+ progress_bar {
    id = "__timeout__"
    left = 25%
    top = 80%
    width = 50%
    height = 8
    text = "@TIMEOUT@"
    font = "Noto Sans 14"
    text_color = "#FFFFFF"
    bar_style = "progress_*.png"
    highlight_style = "progress_highlight_*.png"
}

# Help text at bottom
+ hbox {
    left = 25%
    top = 88%
    width = 50%
    height = 10
    + label {
        text = "↑↓ Select   ·   Enter Boot   ·   e Edit   ·   F2 Options"
        font = "Noto Sans 12"
        color = "#5A8FBC"
        align = "center"
    }
}
EOF

# Generate a simple PNG background (gradient blue) using ImageMagick if available
if command -v convert >/dev/null 2>&1; then
    convert -size 1920x1080 gradient:'#0A2540'-'#0078D4' \
        -gravity center -fill white -pointsize 72 -annotate +0+0 'OSLin' \
        "$THEME_DIR/background.png" 2>/dev/null || true
elif command -v rsvg-convert >/dev/null 2>&1 && [ -f /usr/share/wallpapers/oslin-wallpaper.svg ]; then
    rsvg-convert -w 1920 -h 1080 /usr/share/wallpapers/oslin-wallpaper.svg \
        -o "$THEME_DIR/background.png" 2>/dev/null || true
fi

# If no background was created, GRUB will fall back to plain color (still works)
# Create simple highlight + bullet placeholders if missing
# (These can be replaced with real PNGs later for a fancier look)
if [ ! -f "$THEME_DIR/highlight_c.png" ]; then
    if command -v convert >/dev/null 2>&1; then
        # Highlight: semi-transparent blue rounded rectangle
        convert -size 200x36 xc:none -fill 'rgba(0,120,212,0.6)' \
            -draw "roundrectangle 0,0 200,36 8,8" \
            "$THEME_DIR/highlight_c.png" 2>/dev/null || true
        # Bullet: small white circle
        convert -size 24x24 xc:none -fill white \
            -draw "circle 12,12 12,2" \
            "$THEME_DIR/bullet_c.png" 2>/dev/null || true
    fi
fi

# ---------- Refresh GRUB config (if running in installed system) ----------
# In a live-build chroot, grub-pc is not yet configured for the host disk,
# so update-grub may fail — that's fine, the file is what matters.
if command -v update-grub >/dev/null 2>&1; then
    update-grub 2>/dev/null || true
fi

echo "[OSLin] GRUB configured: 5-second visible menu + OSLin blue theme."
exit 0
