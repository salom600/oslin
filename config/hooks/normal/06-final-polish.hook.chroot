#!/bin/sh
set -e
echo "[OSLin] Aggressive slim-down polish..."

apt-get clean
rm -rf /var/lib/apt/lists/*
rm -rf /var/cache/apt/archives/*.deb
rm -rf /var/cache/apt/archives/partial/*
rm -rf /var/cache/debconf/*
rm -rf /var/cache/man/*

rm -rf /usr/share/doc/*
mkdir -p /usr/share/doc
find /usr/share/doc -type f -name 'README*' -delete 2>/dev/null || true
find /usr/share/doc -type f -name 'changelog*' -delete 2>/dev/null || true
find /usr/share/doc -type f -name 'NEWS*' -delete 2>/dev/null || true
find /usr/share/doc -type f -name 'TODO*' -delete 2>/dev/null || true

if [ -d /usr/share/man ]; then
    find /usr/share/man -mindepth 1 -maxdepth 1 -type d \
        ! -name 'man1' ! -name 'man5' ! -name 'man8' \
        -exec rm -rf {} + 2>/dev/null || true
    find /usr/share/man -type d -name 'man*' -path '*/man/*' \
        -exec rm -rf {} + 2>/dev/null || true
fi

if [ -d /usr/share/locale ]; then
    find /usr/share/locale -type f \
        ! -path '*/en/*' ! -path '*/en_*/_*' \
        ! -path '*/ar/*' ! -path '*/ar_*/_*' \
        ! -name 'locale.alias' \
        -delete 2>/dev/null || true
    find /usr/share/locale -type d -empty -delete 2>/dev/null || true
fi
find /usr/share/locale -name '*.mo' \
    ! -path '*/en/*' ! -path '*/en_*/_*' \
    ! -path '*/ar/*' ! -path '*/ar_*/_*' \
    -delete 2>/dev/null || true

rm -f /usr/share/fonts/truetype/noto/NotoSansCJK*.ttf 2>/dev/null || true
rm -f /usr/share/fonts/truetype/noto/NotoSerifCJK*.ttf 2>/dev/null || true
rm -f /usr/share/fonts/opentype/noto/Noto*CJK* 2>/dev/null || true
find /usr/share/fonts -name 'NotoSans*Extra*' -delete 2>/dev/null || true
find /usr/share/fonts -name 'NotoSerif*Extra*' -delete 2>/dev/null || true
find /usr/share/fonts -name 'NotoColorEmoji.ttf' -delete 2>/dev/null || true
fc-cache -f 2>/dev/null || true

for theme in /usr/share/icons/*; do
    [ -d "$theme" ] || continue
    for size in 8 12 64 72 96 128 192 256 512; do
        rm -rf "$theme/${size}x${size}" 2>/dev/null || true
        rm -rf "$theme/${size}x${size}@2" 2>/dev/null || true
    done
done

rm -f /lib/firmware/mellanox/* 2>/dev/null || true
rm -f /lib/firmware/qed/* 2>/dev/null || true
rm -f /lib/firmware/qcom/* 2>/dev/null || true
rm -f /lib/firmware/bnx2x/* 2>/dev/null || true
rm -f /lib/firmware/netronome/* 2>/dev/null || true

find /lib/modules/*/kernel/drivers/infiniband -type f -delete 2>/dev/null || true
find /lib/modules/*/kernel/drivers/net/ethernet/mellanox -type f -delete 2>/dev/null || true
find /lib/modules/*/kernel/drivers/net/ethernet/netronome -type f -delete 2>/dev/null || true
find /lib/modules/*/kernel/drivers/net/ethernet/intel/i40e -type f -delete 2>/dev/null || true
find /lib/modules/*/kernel/drivers/net/ethernet/intel/iavf -type f -delete 2>/dev/null || true
find /lib/modules/*/kernel/drivers/net/ethernet/intel/ice -type f -delete 2>/dev/null || true

rm -rf /usr/include/*
rm -rf /usr/lib/*.a
rm -rf /usr/lib/*.la
rm -rf /usr/lib/*/include
rm -rf /usr/share/aclocal
rm -rf /usr/share/pkgconfig
find /usr -name '*.a' -delete 2>/dev/null || true
find /usr -name '*.la' -delete 2>/dev/null || true

find /usr/share -type d -name 'examples' -exec rm -rf {} + 2>/dev/null || true
find /usr/share -type d -name 'tests' -exec rm -rf {} + 2>/dev/null || true
find /usr/share -type d -name 'test' -exec rm -rf {} + 2>/dev/null || true

rm -rf /tmp/* /var/tmp/*
find /var/log -type f -exec truncate -s 0 {} \; 2>/dev/null || true
rm -rf /var/log/journal/* 2>/dev/null || true

find / -type f -name '*~' -delete 2>/dev/null || true
find / -type f -name '*.bak' -delete 2>/dev/null || true
find / -type f -name '*.orig' -delete 2>/dev/null || true

systemctl disable apache2 2>/dev/null || true
systemctl disable nginx 2>/dev/null || true
systemctl disable mysql 2>/dev/null || true
systemctl disable postgresql 2>/dev/null || true
systemctl disable redis-server 2>/dev/null || true
systemctl disable cups 2>/dev/null || true

chmod +x /usr/local/bin/oslin-* 2>/dev/null || true
chown -R oslin:oslin /home/oslin 2>/dev/null || true

echo "" > /etc/machine-id
rm -f /var/lib/dbus/machine-id 2>/dev/null || true
ln -s /etc/machine-id /var/lib/dbus/machine-id 2>/dev/null || true

apt-get -y autoremove --purge 2>/dev/null || true
apt-get clean

if command -v du >/dev/null 2>&1; then
    SIZE=$(du -sh / 2>/dev/null | cut -f1)
    echo "[OSLin] Chroot size after slim-down: $SIZE"
fi

echo "[OSLin] Aggressive slim-down complete."
exit 0
