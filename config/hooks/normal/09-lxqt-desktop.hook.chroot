#!/bin/sh
# ============================================
# OSLin - Hook: 09-lxqt-desktop.chroot
# Configures LXQt desktop with OSLin branding
# - Panel at bottom (Win11/macOS-style taskbar)
# - WhiteSur theme
# - Auto-start picom-style compositor (xcompmgr for transparency)
# - Wallpaper
# ============================================
set -e

echo "[OSLin] Setting up LXQt desktop..."

# ---------- 1. Create LXQt session entry ----------
mkdir -p /usr/share/xsessions
cat > /usr/share/xsessions/lxqt.desktop <<'EOF'
[Desktop Entry]
Type=Session
Name=OSLin (LXQt)
Comment=OSLin lightweight desktop
Exec=startlxqt
TryExec=startlxqt
DesktopNames=OSLin;LXQt;
EOF

# Remove any old session entries
rm -f /usr/share/xsessions/sway.desktop /usr/share/wayland-sessions/sway.desktop 2>/dev/null || true
rm -f /usr/share/xsessions/xfce.desktop 2>/dev/null || true

# ---------- 2. Configure LightDM to use LXQt ----------
if [ -f /etc/lightdm/lightdm.conf ]; then
    sed -i 's/^user-session=.*/user-session=lxqt/' /etc/lightdm/lightdm.conf 2>/dev/null || true
    sed -i 's/^autologin-session=.*/autologin-session=lxqt/' /etc/lightdm/lightdm.conf 2>/dev/null || true
fi

# ---------- 3. Create LXQt config in skeleton ----------
SKEL_LXQT="/etc/skel/.config/lxqt"
mkdir -p "$SKEL_LXQT"

# Session config
cat > "$SKEL_LXQT/session.conf" <<'EOF'
[General]
__userfile__=true
leave_confirmation=true

[Environment]
GTK_THEME=WhiteSur-Light
QT_QPA_PLATFORMTHEME=gtk2

[Mouse]
cursor_theme=WhiteSur-cursors
cursor_size=24
EOF

# Panel config (bottom taskbar with tasklist, tray, clock)
mkdir -p "$SKEL_LXQT/panel.conf.d"
cat > "$SKEL_LXQT/panel.conf" <<'EOF'
[General]
__userfile__=true

[panel1]
alignment=-1
background-color=@Variant(\0\0\0\x43\x1\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff)
background-image=
desktop=0
font-color=@Variant(\0\0\0\x43\1\xff\xff\xf0\xf0\xf0\xf0\xf0\xf0)
font-size=11
font-weight=400
hide-on-overlap=false
iconSize=22
lineCount=1
lockPanel=false
opacity=85
panelSize=32
placement=2
position=Bottom
reserve-space=true
show-delay=0
visible-margin=true
width=100
width-percent=true

# Plugins (left to right):
# 1. mainmenu (Start button)
# 2. quicklaunch (pinned apps)
# 3. tasklist (open windows)
# 4. spacer (expanding)
# 5. tray (system tray)
# 6. volume (audio)
# 7. network (Wi-Fi)
# 8. clock (time)
# 9. mount (removable devices)
# 10. logout (power button)

[mainmenu]
alignment=0
customMenu=
filterShow=true
filterShowFilterMenu=true
filterShowConfigure=true
icon=oslin-logo
showText=false
text=Applications
width=400

[quicklaunch]
alignment=0
apps\1\desktop=/usr/share/applications/brave-browser.desktop
apps\2\desktop=/usr/share/applications/pcmanfm-qt.desktop
apps\3\desktop=/usr/share/applications/qterminal.desktop
apps\4\desktop=/usr/share/applications/oslin-store.desktop
apps\size=4

[tasklist]
alignment=1
buttonHeight=28
buttonWidth=160
closeOnMiddleClick=true
groupingEnabled=true
raiseOnCurrentDesktop=false
showOnlyCurrentDesktopTasks=false
wheelEventsAction=1

[tray]
alignment=2

[volume]
alignment=2
device=0
mixerCommand=pavucontrol
showKeyboardNotifications=true
volumeStep=5

[kbindicator]
alignment=2
autoHide=false
keepAspectRatio=true
layout=us,ar
showFlag=true
showLabel=false
switchOnScroll=true

[clock]
alignment=2
dateFormat=HH:mm
dateOnNewLine=false
firstDayOfWeek=1
format=0
longDateFormat=dddd, MMMM d
showDate=0
showSeconds=false
timeFormat=HH:mm
useAdvancedFormat=false

[mount]
alignment=2

[logout]
alignment=2
confirm=true
icon=system-shutdown
text=
EOF

# ---------- 4. Create Openbox config (window manager) ----------
SKEL_OB="/etc/skel/.config/openbox"
mkdir -p "$SKEL_OB"
cat > "$SKEL_OB/lxqt-rc.xml" <<'XMLEOF'
<?xml version="1.0" encoding="UTF-8"?>
<openbox_config xmlns="http://openbox.org/3.4/rc">
  <resistance>
    <strength>10</strength>
    <screen_edge_strength>20</screen_edge_strength>
  </resistance>
  <focus>
    <focusNew>yes</focusNew>
    <focusLast>yes</focusLast>
    <followMouse>no</followMouse>
    <focusDelay>0</focusDelay>
    <raiseOnFocus>no</raiseOnFocus>
  </focus>
  <theme>
    <name>WhiteSur-Light</name>
    <titleLayout>NLIMC</titleLayout>
    <font place="ActiveWindow">
      <name>Noto Sans</name>
      <size>11</size>
      <weight>Bold</weight>
      <slant>Normal</slant>
    </font>
    <font place="InactiveWindow">
      <name>Noto Sans</name>
      <size>11</size>
      <weight>Normal</weight>
      <slant>Normal</slant>
    </font>
  </theme>
  <desktops>
    <number>4</number>
    <firstdesk>1</firstdesk>
    <names>
      <name>1</name><name>2</name><name>3</name><name>4</name>
    </names>
    <popupTime>875</popupTime>
  </desktops>
  <keyboard>
    <!-- Window snap (Win11-style) -->
    <keybind key="W-Left">
      <action name="UnmaximizeFull"/>
      <action name="MoveResizeTo">
        <x>0</x>
        <y>0</y>
        <width>50%</width>
        <height>100%</height>
      </action>
    </keybind>
    <keybind key="W-Right">
      <action name="UnmaximizeFull"/>
      <action name="MoveResizeTo">
        <x>50%</x>
        <y>0</y>
        <width>50%</width>
        <height>100%</height>
      </action>
    </keybind>
    <keybind key="W-Up">
      <action name="MaximizeFull"/>
    </keybind>
    <keybind key="W-Down">
      <action name="UnmaximizeFull"/>
    </keybind>
    <!-- App shortcuts -->
    <keybind key="W-d">
      <action name="Execute"><command>pcmanfm-qt</command></action>
    </keybind>
    <keybind key="W-t">
      <action name="Execute"><command>qterminal</command></action>
    </keybind>
    <keybind key="W-b">
      <action name="Execute"><command>brave-browser</command></action>
    </keybind>
    <keybind key="W-s">
      <action name="Execute"><command>oslin-store</command></action>
    </keybind>
    <keybind key="W-i">
      <action name="Execute"><command>oslin-control-center</command></action>
    </keybind>
    <keybind key="W-space">
      <action name="Execute"><command>lxqt-runner</command></action>
    </keybind>
    <!-- Desktop switching -->
    <keybind key="C-A-Left"><action name="DesktopLeft"/></keybind>
    <keybind key="C-A-Right"><action name="DesktopRight"/></keybind>
    <keybind key="C-A-Down"><action name="DesktopDown"/></keybind>
    <keybind key="C-A-Up"><action name="DesktopUp"/></keybind>
  </keyboard>
  <mouse>
    <context name="Frame">
      <mousebind button="W-Left" action="Press">
        <action name="Focus"/>
        <action name="Raise"/>
      </mousebind>
      <mousebind button="W-Left" action="Drag">
        <action name="Move"/>
      </mousebind>
      <mousebind button="W-Right" action="Press">
        <action name="Focus"/>
        <action name="Raise"/>
        <action name="Resize"/>
      </mousebind>
    </context>
  </mouse>
</openbox_config>
XMLEOF

# ---------- 5. Create autostart entries ----------
SKEL_AUTO="/etc/skel/.config/autostart"
mkdir -p "$SKEL_AUTO"

# Start xcompmgr (transparency/blur compositor for X11)
cat > "$SKEL_AUTO/xcompmgr.desktop" <<'EOF'
[Desktop Entry]
Type=Application
Name=X Compositor
Comment=Enable transparency and shadows
Exec=xcompmgr -c -C -t-5 -l-5 -r4.2 -o.55
Hidden=false
NoDisplay=false
X-GNOME-Autostart-enabled=true
OnlyShowIn=LXQt;
EOF

# Set wallpaper on login
cat > "$SKEL_AUTO/wallpaper.desktop" <<'EOF'
[Desktop Entry]
Type=Application
Name=Wallpaper
Comment=Set OSLin wallpaper
Exec=pcmanfm-qt --set-wallpaper=/usr/share/wallpapers/oslin/wallpaper-default.png --wallpaper-mode=fill
Hidden=false
NoDisplay=false
X-GNOME-Autostart-enabled=true
OnlyShowIn=LXQt;
EOF

# OSLin first-login setup
cat > "$SKEL_AUTO/oslin-first-login.desktop" <<'EOF'
[Desktop Entry]
Type=Application
Name=OSLin First Login
Comment=Apply customizations
Exec=/usr/local/bin/oslin-first-login
Hidden=false
NoDisplay=false
X-GNOME-Autostart-enabled=true
OnlyShowIn=LXQt;
StartupNotify=false
EOF

# ---------- 6. Copy to live user ----------
if [ -d /home/oslin ]; then
    mkdir -p /home/oslin/.config/lxqt
    cp -r "$SKEL_LXQT/"* /home/oslin/.config/lxqt/

    mkdir -p /home/oslin/.config/openbox
    cp "$SKEL_OB/lxqt-rc.xml" /home/oslin/.config/openbox/

    mkdir -p /home/oslin/.config/autostart
    cp "$SKEL_AUTO/"* /home/oslin/.config/autostart/

    chown -R oslin:oslin /home/oslin/.config
fi

# ---------- 7. Configure GTK theme (for Qt apps via gtk2 style) ----------
mkdir -p /etc/skel/.config/gtk-3.0
cat > /etc/skel/.config/gtk-3.0/settings.ini <<'EOF'
[Settings]
gtk-theme-name=WhiteSur-Light
gtk-icon-theme-name=WhiteSur
gtk-font-name=Noto Sans 11
gtk-cursor-theme-name=WhiteSur-cursors
gtk-application-prefer-dark-theme=0
gtk-enable-animations=1
EOF

# ---------- 8. Ensure oslin user is in required groups ----------
if id oslin >/dev/null 2>&1; then
    for g in video audio input plugdev netdev bluetooth; do
        getent group "$g" >/dev/null 2>&1 && usermod -aG "$g" oslin 2>/dev/null || true
    done
fi

# ---------- 9. Create Pictures dir ----------
mkdir -p /etc/skel/Pictures
[ -d /home/oslin ] && mkdir -p /home/oslin/Pictures && chown oslin:oslin /home/oslin/Pictures

echo "[OSLin] LXQt desktop setup complete:"
echo "  - LXQt session configured (works on ALL hardware, X11)"
echo "  - Panel at bottom (taskbar with tasklist, tray, clock)"
echo "  - Openbox window manager (with Win11-style snap shortcuts)"
echo "  - xcompmgr compositor (transparency + shadows)"
echo "  - WhiteSur theme"
echo "  - Auto-start: wallpaper, compositor, first-login"
echo "  - Keyboard shortcuts: Super+D=Files, Super+T=Terminal, Super+Space=Runner"
exit 0
