#!/bin/sh
set -e
echo "[OSLin] Installing default theme (WhiteSur - macOS look)..."
THEMES_DIR="/usr/share/themes"
ICONS_DIR="/usr/share/icons"
TMP_DIR="/tmp/oslin-themes"
mkdir -p "$TMP_DIR"
cd "$TMP_DIR"

if [ ! -d "$THEMES_DIR/WhiteSur-Light" ]; then
    git clone --depth=1 https://github.com/vinceliuice/WhiteSur-gtk-theme.git whitesur-gtk 2>/dev/null || true
    if [ -d "whitesur-gtk" ]; then
        cd whitesur-gtk
        chmod +x install.sh
        ./install.sh -t standard -s standard --tweaks round -d "$THEMES_DIR" 2>/dev/null || true
        cd ..
        rm -rf whitesur-gtk
    fi
fi

if [ ! -d "$ICONS_DIR/WhiteSur" ]; then
    git clone --depth=1 https://github.com/vinceliuice/WhiteSur-icon-theme.git whitesur-icons 2>/dev/null || true
    if [ -d "whitesur-icons" ]; then
        cd whitesur-icons
        chmod +x install.sh
        ./install.sh -d "$ICONS_DIR" 2>/dev/null || true
        cd ..
        rm -rf whitesur-icons
    fi
fi

if [ ! -d "$ICONS_DIR/WhiteSur-cursors" ]; then
    git clone --depth=1 https://github.com/vinceliuice/WhiteSur-cursors.git whitesur-cursors 2>/dev/null || true
    if [ -d "whitesur-cursors" ]; then
        cd whitesur-cursors
        chmod +x install.sh
        ./install.sh -d "$ICONS_DIR" 2>/dev/null || true
        cd ..
        rm -rf whitesur-cursors
    fi
fi

mkdir -p /usr/share/wallpapers/oslin
cd /
rm -rf "$TMP_DIR"
apt-get clean 2>/dev/null || true
echo "[OSLin] Default theme installed (WhiteSur). Fluent (Win11) available via Control Center."
exit 0
