#!/bin/sh
# ============================================
# OSLin - Hook: 08-modern-desktop.chroot (Sway/Wayland version)
# Installs:
#   - Brave browser (replaces Firefox)
#   - Bottles (one-click .exe support via Flatpak)
#   - Custom Plymouth boot splash theme
#   - Window snap script (for floating windows)
# Note: picom and rofi are NOT needed on Wayland (Sway has native compositor + wofi)
# ============================================
set +e  # tolerant mode for chroot build

echo "[OSLin] Setting up modern desktop (Brave, Bottles, Plymouth)..."

# ---------- 1. Install Brave browser ----------
echo "[OSLin] Installing Brave browser..."
if ! command -v brave-browser >/dev/null 2>&1; then
    apt-get update -qq
    apt-get install -y --no-install-recommends curl gnupg apt-transport-https 2>/dev/null || true

    curl -fsSLo /usr/share/keyrings/brave-browser-archive-keyring.gpg \
        https://brave-browser-apt-release.s3.brave.com/brave-browser-archive-keyring.gpg 2>/dev/null || true

    echo "deb [signed-by=/usr/share/keyrings/brave-browser-archive-keyring.gpg] https://brave-browser-apt-release.s3.brave.com/ stable main" \
        > /etc/apt/sources.list.d/brave-browser-release.list

    apt-get update -qq 2>/dev/null || true
    apt-get install -y --no-install-recommends brave-browser 2>/dev/null || {
        echo "[OSLin] WARNING: Brave install failed — will fall back to Firefox ESR"
        apt-get install -y --no-install-recommends firefox-esr 2>/dev/null || true
    }
fi

if command -v brave-browser >/dev/null 2>&1; then
    apt-get purge -y firefox-esr firefox-esr-l10n-* 2>/dev/null || true
    echo "[OSLin] Brave installed, Firefox removed."
fi

# ---------- 2. Install Bottles via Flatpak (one-click .exe) ----------
echo "[OSLin] Installing Bottles for Windows .exe support..."
if command -v flatpak >/dev/null 2>&1; then
    flatpak remote-add --if-not-exists flathub https://flathub.org/repo/flathub.flatpakrepo 2>/dev/null || true
    flatpak install -y --system flathub com.usebottles.bottles 2>/dev/null || {
        echo "[OSLin] WARNING: Bottles install failed — users can install from store later"
    }
fi

# ---------- 3. Custom Plymouth boot splash ----------
echo "[OSLin] Configuring Plymouth boot splash..."
if command -v plymouth-set-default-theme >/dev/null 2>&1; then
    PLYMOUTH_THEME_DIR="/usr/share/plymouth/themes/oslin"
    mkdir -p "$PLYMOUTH_THEME_DIR"

    cat > "$PLYMOUTH_THEME_DIR/oslin.script" <<'PSCROLL'
screen_width = Window.GetWidth();
screen_height = Window.GetHeight();

fun refresh_callback() {
    # Background gradient
    bg = Image.New(screen_width, screen_height);
    bg.Fill(0x0A, 0x25, 0x40);
    bg_sprite = Sprite(bg);
    bg_sprite.SetPosition(0, 0, 0);

    # Logo (if available)
    if (FileExists("/usr/share/plymouth/themes/oslin/oslin-logo.png")) {
        logo = Image("oslin-logo.png");
        logo = logo.Scale(logo.GetWidth() * 0.5, logo.GetHeight() * 0.5);
        logo_sprite = Sprite(logo);
        logo_sprite.SetX(screen_width / 2 - logo.GetWidth() / 2);
        logo_sprite.SetY(screen_height / 2 - logo.GetHeight() / 2 - 30);
    }

    # Progress bar
    pw = screen_width * 0.3;
    ph = 6;
    px = (screen_width - pw) / 2;
    py = screen_height * 0.7;

    bg_bar = Sprite(Image.New(pw, ph));
    bg_bar.SetPosition(px, py, 0);
    bg_bar.SetOpacity(0.3);

    fill = Sprite(Image.New(pw * Plymouth.GetProgress(), ph));
    fill.SetPosition(px, py, 0);

    # Text
    text = Image.Text("OSLin 2026.1 Aurora", 1.0, 1.0, 1.0, 1.0, "Noto Sans 24");
    text_sprite = Sprite(text);
    text_sprite.SetX(screen_width / 2 - text.GetWidth() / 2);
    text_sprite.SetY(py + 20);
}

Plymouth.SetRefreshFunction(refresh_callback);
PSCROLL

    cat > "$PLYMOUTH_THEME_DIR/oslin.plymouth" <<'EOF'
[Plymouth Theme]
Name=OSLin
Description=OSLin 2026.1 Aurora boot splash
ModuleName=script

[script]
ImageDir=/usr/share/plymouth/themes/oslin
ScriptFile=/usr/share/plymouth/themes/oslin/oslin.script
EOF

    # Copy OSLin logo as PNG
    if [ -f /usr/share/icons/hicolor/scalable/apps/oslin-logo.svg ]; then
        if command -v rsvg-convert >/dev/null 2>&1; then
            rsvg-convert -w 256 -h 256 /usr/share/icons/hicolor/scalable/apps/oslin-logo.svg \
                -o "$PLYMOUTH_THEME_DIR/oslin-logo.png" 2>/dev/null || true
        fi
    fi

    plymouth-set-default-theme oslin -R 2>/dev/null || true
    echo "[OSLin] Plymouth theme set to 'oslin'."
fi

# ---------- 4. Clean up ----------
apt-get clean 2>/dev/null || true

echo "[OSLin] Modern desktop setup complete (Sway/Wayland):"
echo "  - Brave browser (replaced Firefox)"
echo "  - Bottles (one-click .exe support)"
echo "  - Custom Plymouth boot splash"
exit 0
