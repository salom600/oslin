# ============================================
# OSLin - Games & Windows .exe support
# One-click .exe support via Bottles + Wine + Proton
# ============================================

# --- Wine (run Windows .exe files) ---
wine
wine64
libwine
fonts-wine
wine-binfmt

# --- Bottles: modern GUI for Wine (one-click .exe install) ---
# Installed via Flatpak from Flathub in the store hook
# (Bottles is the modern alternative to PlayOnLinux)

# --- Lutris: game launcher (Steam, Epic, GOG, emulators) ---
lutris

# --- Heroic Games Launcher (Epic + GOG) ---
# Installed via Flatpak from Flathub

# --- Steam (via Flatpak in store hook) ---
# Native steam-installer needs i386 multiarch — we use Flatpak instead

# --- Game tools ---
gamemode
libgamemode0
gamescope
mangohud

# --- Pre-installed lightweight games (4 classics) ---
aisleriot
gnome-mines
gnome-sudoku
gnuchess
