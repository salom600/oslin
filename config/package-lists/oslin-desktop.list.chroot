# ============================================
# OSLin - Custom Shell (Openbox + Polybar + Picom + Rofi)
# NOT a desktop environment — a custom-built modern shell
# Works on ALL hardware (X11), ~50-80MB RAM for the shell
# ============================================

# ─── Openbox: window manager (rock solid, works everywhere) ───
openbox
obconf
# libxml2 for openbox config parsing (pulled automatically)

# ─── Polybar: custom status bar (modern, animated, glass) ───
polybar

# ─── Picom: compositor (blur, transparency, rounded corners, animations) ───
picom

# ─── Rofi: Spotlight-style app launcher ───
rofi

# ─── Nitrogen: wallpaper manager ───
nitrogen
feh

# ─── X server (universal — ALL hardware) ───
xserver-xorg
xserver-xorg-video-all
xserver-xorg-video-amdgpu
xserver-xorg-video-ati
xserver-xorg-video-intel
xserver-xorg-video-nouveau
xserver-xorg-video-vesa
xserver-xorg-video-fbdev
xserver-xorg-video-qxl
xserver-xorg-video-vmware
x11-xserver-utils
xauth
xinit
x11-common

# ─── Mesa GL (hardware accel, no proprietary drivers needed) ───
mesa-va-drivers
mesa-vulkan-drivers
libgl1-mesa-dri
libglx-mesa0
libgl1
libegl1
libegl-mesa0

# ─── Display manager ───
lightdm
lightdm-gtk-greeter

# ─── Audio ───
pulseaudio
pavucontrol
alsa-utils

# ─── Network ───
network-manager
network-manager-gnome
wpasupplicant

# ─── Bluetooth ───
bluez
blueman

# ─── Themes / icons ───
gtk2-engines-murrine
gtk2-engines-pixbuf
papirus-icon-theme

# ─── Fonts ───
fonts-noto-core
fonts-noto-ui-core
fonts-noto-mono
fonts-dejavu-core
fonts-liberation2
fonts-kacst
fonts-hosny-amiri
fonts-font-awesome

# ─── File manager + terminal + editor ───
thunar
thunar-archive-plugin
thunar-volman
tumbler
xfce4-terminal
mousepad
ristretto
file-roller
p7zip-full

# ─── GUI dialogs ───
zenity

# ─── Notifications ───
libnotify-bin
dunst

# ─── Image tools (SVG→PNG) ───
librsvg2-bin
imagemagick

# ─── Plymouth boot splash ───
plymouth
plymouth-themes
plymouth-x11

# ─── Window snap helper ───
wmctrl
xdotool

# ─── Polkit (for GUI sudo) ───
policykit-1
policykit-1-gnome

# ─── XDG utils (for default apps) ───
xdg-utils
desktop-file-utils
