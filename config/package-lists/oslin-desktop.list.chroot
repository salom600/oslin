# ============================================
# OSLin - Desktop Environment (LXQt - lightweight, works on ALL hardware)
# Replaces Sway (which failed on unknown GPUs) and XFCE
# ~300MB total, ~250MB RAM idle, X11 (universal compatibility)
# ============================================

# ─── LXQt desktop (lightweight Qt-based DE) ───
lxqt
lxqt-core
lxqt-admin
lxqt-config
lxqt-globalkeys
lxqt-notificationd
lxqt-openssh-askpass
lxqt-panel
lxqt-policykit
lxqt-powermanagement
lxqt-qtplugin
lxqt-runner
lxqt-session
lxqt-sudo
lxqt-themes

# ─── Openbox (window manager for LXQt) ───
openbox
openbox-themes
obconf-qt

# ─── PCManFM-Qt (file manager) ───
pcmanfm-qt
libfm-qt-dev

# ─── QTerminal (terminal emulator) ───
qterminal
qtermwidget

# ─── FeatherPad (text editor) ───
featherpad

# ─── Screenshot tool ───
screengrab

# ─── Archiver ───
file-roller
p7zip-full

# ─── Display manager ───
lightdm
lightdm-gtk-greeter

# ─── X server (universal — works on ALL hardware) ───
