# ============================================
# OSLin - Desktop Environment (SWAY Wayland - modern, lightweight, animated)
# Replaces XFCE entirely. ~250MB total, ~150-200MB RAM idle.
# ============================================

# ─── Sway: Wayland compositor (i3-compatible, tiling + floating) ───
sway
sway-backgrounds
swaylock
swayidle
sway-notification-center
# SwayFX fork features (blur, rounded corners, animations) come from swayfx package
# On Debian Bookworm, standard sway + our config gives the modern look

# ─── Waybar: modern, customizable status bar (replaces XFCE panel) ───
waybar
# Fonts for waybar (icons)
fonts-font-awesome

# ─── Wofi: Wayland app launcher (replaces rofi/whiskermenu) ───
wofi

# ─── Wayland utilities ───
wl-clipboard
slurp
grim
mako-notifier
kanshi
wdisplays

# ─── XWayland (for running X11 apps like Bottles/Wine) ───
xwayland

# ─── Polkit (for GUI privilege escalation) ───
policykit-1-gnome

# ─── Display manager (LightDM works with Wayland via sway session) ───
lightdm
lightdm-gtk-greeter

# ─── Wallpapers / appearance ───
swaybg

# ─── Audio ───
pulseaudio
pavucontrol
alsa-utils
pulseaudio-utils

# ─── Network ───
network-manager
network-manager-gnome
wpasupplicant

# ─── Bluetooth ───
bluez
blueman

# ─── Themes (GTK still used by file manager etc.) ───
gtk2-engines-murrine
gtk2-engines-pixbuf
papirus-icon-theme

# ─── Fonts ───
fonts-noto-core
fonts-noto-ui-core
fonts-noto-mono
fonts-dejavu-core
fonts-liberation2
fonts-kacst
fonts-hosny-amiri

# ─── File manager + terminal + text editor ───
thunar
thunar-archive-plugin
thunar-volman
tumbler
xfce4-terminal
mousepad
ristretto
file-roller
p7zip-full

# ─── GUI dialogs ───
zenity

# ─── Mesa GL (hardware accel for Wayland) ───
mesa-va-drivers
mesa-vulkan-drivers
libgl1-mesa-dri
libglx-mesa0
libgl1
libegl1
libegl-mesa0
vulkan-tools

# ─── Notifications ───
libnotify-bin
notify-osd

# ─── Image tools (SVG→PNG) ───
librsvg2-bin
imagemagick

# ─── Plymouth boot splash ───
plymouth
plymouth-themes
plymouth-x11

# ─── Window snap helper (still useful for floating windows) ───
wmctrl
