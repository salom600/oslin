#!/bin/bash
# ============================================
# OSLin - Hardware Detection & Driver Installer (NON-BLOCKING)
#
# Behavior:
#   - Runs in background after desktop is up
#   - Detects GPU vendor (Nvidia / AMD / Intel)
#   - If internet is available → installs proprietary drivers
#   - If NO internet → records hardware profile, shows desktop notification
#     telling the user "drivers will install when you connect to internet"
#   - Never blocks boot, never crashes the system
# ============================================
set -u

LOG=/var/log/oslin-hw-detect.log
mkdir -p "$(dirname "$LOG")"
exec > >(tee -a "$LOG") 2>&1

. /etc/oslin/oslin-common 2>/dev/null || true

echo "=========================================="
echo " OSLin Hardware Detection (non-blocking)"
echo " $(date)"
echo "=========================================="

mkdir -p /etc/oslin

# ---------- Step 1: Always detect hardware (no internet needed) ----------
detect_cpu() {
    local cpu_vendor
    cpu_vendor=$(grep -m1 'vendor_id' /proc/cpuinfo | awk '{print $3}')
    echo "Detected CPU vendor: $cpu_vendor"
    echo "$cpu_vendor" > /etc/oslin/hw-cpu-vendor
}

detect_gpu() {
    local gpu_vendor="unknown"
    local gpu_model="unknown"
    local gpu_pci=""

    while IFS= read -r line; do
        gpu_pci+="$line"$'\n'
    done < <(lspci -nn | grep -iE 'VGA|3D|Display')

    if echo "$gpu_pci" | grep -qi 'nvidia'; then
        gpu_vendor="nvidia"
        gpu_model=$(echo "$gpu_pci" | grep -i 'nvidia' | head -1 | sed 's/.*:\s*//')
    elif echo "$gpu_pci" | grep -qi 'advanced micro devices\|amd\|ati\b\|radeon'; then
        gpu_vendor="amd"
        gpu_model=$(echo "$gpu_pci" | grep -iE 'amd|ati|radeon' | head -1 | sed 's/.*:\s*//')
    elif echo "$gpu_pci" | grep -qi 'intel'; then
        gpu_vendor="intel"
        gpu_model=$(echo "$gpu_pci" | grep -i 'intel' | head -1 | sed 's/.*:\s*//')
    fi

    echo "Detected GPU vendor: $gpu_vendor"
    echo "Detected GPU model:  $gpu_model"
    echo "$gpu_vendor" > /etc/oslin/hw-gpu-vendor
    echo "$gpu_model"  > /etc/oslin/hw-gpu-model
}

# Always run detection (this works offline)
detect_cpu
detect_gpu
GPU_VENDOR=$(cat /etc/oslin/hw-gpu-vendor 2>/dev/null || echo "unknown")

# Persist a hardware profile (so we don't re-detect on every boot)
cat > /etc/oslin/hw-profile <<EOF
# OSLin Hardware Profile - auto-generated
GENERATED_AT=$(date -u +"%Y-%m-%dT%H:%M:%SZ")
CPU_VENDOR=$(cat /etc/oslin/hw-cpu-vendor 2>/dev/null)
GPU_VENDOR=$GPU_VENDOR
GPU_MODEL=$(cat /etc/oslin/hw-gpu-model 2>/dev/null)
KERNEL=$(uname -r)
MEMORY_KB=$(grep MemTotal /proc/meminfo | awk '{print $2}')
DRIVERS_INSTALLED=no
EOF

echo "[OSLin] Hardware profile saved (offline detection complete)."

# ---------- Step 2: Check for internet (15s timeout) ----------
INTERNET=0
if ping -c 1 -W 5 deb.debian.org >/dev/null 2>&1; then
    INTERNET=1
    echo "[OSLin] Internet connection available."
else
    echo "[OSLin] No internet connection. Will install drivers later."
fi

# ---------- Step 3: If offline, just notify and exit ----------
if [ "$INTERNET" -eq 0 ]; then
    echo "[OSLin] Skipping driver installation (offline)."
    echo "[OSLin] Open-source drivers (mesa/nouveau/amdgpu/i915) are already"
    echo "[OSLin] in the kernel — your desktop will work without proprietary drivers."

    # Show a desktop notification (best-effort; ignore if it fails)
    if command -v notify-send >/dev/null 2>&1; then
        sudo -u oslin DISPLAY=:0 DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/$(id -u oslin)/bus \
            notify-send -u normal -i network-wireless-offline \
                "OSLin Hardware Detection" \
                "Internet connection required to install proprietary drivers (Nvidia / AMD / Intel).
Your desktop works fine with open-source drivers. When you connect to the internet, click the OSLin Control Center → 'Install Drivers' to finish setup." \
            2>/dev/null || true
    fi

    # Mark profile to indicate drivers are pending
    sed -i 's/DRIVERS_INSTALLED=no/DRIVERS_INSTALLED=pending-internet/' /etc/oslin/hw-profile
    echo "[OSLin] Done (offline mode). Exiting 0."
    exit 0
fi

# ---------- Step 4: Online → install proprietary drivers ----------
install_nvidia() {
    echo "[OSLin] Installing NVIDIA proprietary drivers..."
    apt-get update -qq
    apt-get install -y --no-install-recommends \
        nvidia-driver \
        nvidia-kernel-dkms \
        nvidia-smi \
        nvidia-settings \
        libnvidia-cfg1 \
        libnvidia-encode1 \
        libnvidia-gl1 2>&1 | tail -5
    cat > /etc/modprobe.d/blacklist-nouveau.conf <<'EOF'
blacklist nouveau
options nouveau modeset=0
EOF
    update-initramfs -u 2>&1 | tail -3
}

install_amd() {
    echo "[OSLin] Installing AMD proprietary drivers + firmware..."
    apt-get update -qq
    apt-get install -y --no-install-recommends \
        firmware-amd-graphics \
        mesa-va-drivers \
        mesa-vdpau-drivers \
        mesa-vulkan-drivers \
        libgl1-mesa-dri 2>&1 | tail -5
}

install_intel() {
    echo "[OSLin] Installing Intel media drivers..."
    apt-get update -qq
    apt-get install -y --no-install-recommends \
        firmware-misc-nonfree \
        intel-media-va-driver \
        mesa-va-drivers \
        mesa-vulkan-drivers \
        libgl1-mesa-dri 2>&1 | tail -5
}

case "$GPU_VENDOR" in
    nvidia) install_nvidia ;;
    amd)    install_amd    ;;
    intel)  install_intel  ;;
    *)
        echo "[OSLin] Unknown GPU vendor. Generic Mesa stack already in kernel."
        ;;
esac

# Update profile
sed -i 's/DRIVERS_INSTALLED=no/DRIVERS_INSTALLED=yes/' /etc/oslin/hw-profile

# Notify user via desktop notification
if command -v notify-send >/dev/null 2>&1; then
    sudo -u oslin DISPLAY=:0 DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/$(id -u oslin)/bus \
        notify-send -u normal -i appointment-soon \
            "OSLin Hardware Detection" \
            "Drivers for your $GPU_VENDOR GPU have been installed. Reboot to activate them." \
        2>/dev/null || true
fi

echo "[OSLin] Driver installation complete."
echo "=========================================="
exit 0
