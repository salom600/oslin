#!/bin/bash
# OSLin First Login Setup - simplified, never fails
set +e

sleep 2

CONFIG_DIR="$HOME/.config"

# Ensure configs exist (copy from system if missing)
[ ! -f "$CONFIG_DIR/openbox/rc.xml" ] && mkdir -p "$CONFIG_DIR/openbox" && cp /etc/xdg/openbox/rc.xml "$CONFIG_DIR/openbox/" 2>/dev/null
[ ! -f "$CONFIG_DIR/tint2/tint2rc" ] && mkdir -p "$CONFIG_DIR/tint2" && cp /etc/xdg/tint2/tint2rc "$CONFIG_DIR/tint2/" 2>/dev/null
[ ! -f "$CONFIG_DIR/picom/picom.conf" ] && mkdir -p "$CONFIG_DIR/picom" && cp /etc/oslin/picom.conf "$CONFIG_DIR/picom/" 2>/dev/null
[ ! -f "$CONFIG_DIR/gtk-3.0/settings.ini" ] && mkdir -p "$CONFIG_DIR/gtk-3.0" && cp /etc/skel/.config/gtk-3.0/settings.ini "$CONFIG_DIR/gtk-3.0/" 2>/dev/null

mkdir -p "$CONFIG_DIR/oslin"
date -u +"%Y-%m-%dT%H:%M:%SZ" > "$CONFIG_DIR/oslin/.first-login-done"

exit 0
