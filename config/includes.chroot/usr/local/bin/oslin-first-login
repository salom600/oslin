#!/bin/bash
set -u
sleep 3
if [ "$(id -u)" -eq 0 ]; then exit 0; fi

CONFIG_DIR="$HOME/.config"
XFCE_DIR="$CONFIG_DIR/xfce4"
XFCONF_DIR="$XFCE_DIR/xfconf/xfce-perchannel-xml"

# Ensure XFCE panel config
if [ ! -f "$XFCONF_DIR/xfce4-panel.xml" ] || ! grep -q "panel-1" "$XFCONF_DIR/xfce4-panel.xml" 2>/dev/null; then
    mkdir -p "$XFCONF_DIR"
    pkill -u "$USER" xfconfd 2>/dev/null || true
    sleep 1
    [ -f /etc/oslin/xfce4-panel.xml ] && cp /etc/oslin/xfce4-panel.xml "$XFCONF_DIR/xfce4-panel.xml"
    xfce4-panel -r 2>/dev/null || true
fi

# Ensure theme config
if [ ! -f "$XFCONF_DIR/xsettings.xml" ] || ! grep -q "WhiteSur" "$XFCONF_DIR/xsettings.xml" 2>/dev/null; then
    [ -f /etc/oslin/xsettings.xml ] && cp /etc/oslin/xsettings.xml "$XFCONF_DIR/xsettings.xml"
fi

# Ensure window manager config
if [ ! -f "$XFCONF_DIR/xfwm4.xml" ] || ! grep -q "use_compositing" "$XFCONF_DIR/xfwm4.xml" 2>/dev/null; then
    [ -f /etc/oslin/xfwm4.xml ] && cp /etc/oslin/xfwm4.xml "$XFCONF_DIR/xfwm4.xml"
fi

# Ensure keyboard shortcuts
if [ ! -f "$XFCONF_DIR/xfce4-keyboard-shortcuts.xml" ]; then
    [ -f /etc/oslin/xfce4-keyboard-shortcuts.xml ] && cp /etc/oslin/xfce4-keyboard-shortcuts.xml "$XFCONF_DIR/xfce4-keyboard-shortcuts.xml"
fi

# Start picom
if ! pgrep -u "$USER" picom >/dev/null 2>&1; then
    if command -v picom >/dev/null 2>&1; then
        xfconf-query -c xfwm4 -p /general/use_compositing -s false 2>/dev/null || true
        picom --config /etc/oslin/picom.conf --daemon 2>/dev/null &
        sleep 2
        if ! pgrep -u "$USER" picom >/dev/null 2>&1; then
            xfconf-query -c xfwm4 -p /general/use_compositing -s true 2>/dev/null || true
        fi
    fi
fi

# Set wallpaper
if command -v xfconf-query >/dev/null 2>&1; then
    CURRENT=$(xfconf-query -c xfce4-desktop -p /backdrop/screen0/monitor0/image-path 2>/dev/null || echo "")
    if [ -z "$CURRENT" ] || [ ! -f "$CURRENT" ]; then
        if [ -f /usr/share/wallpapers/oslin/wallpaper-default.png ]; then
            for prop in $(xfconf-query -c xfce4-desktop -l 2>/dev/null | grep 'image-path$'); do
                xfconf-query -c xfce4-desktop -p "$prop" -s /usr/share/wallpapers/oslin/wallpaper-default.png 2>/dev/null || true
            done
        fi
    fi
fi

mkdir -p "$CONFIG_DIR/oslin"
date -u +"%Y-%m-%dT%H:%M:%SZ" > "$CONFIG_DIR/oslin/.first-login-done"
exit 0
