#!/bin/bash
# ============================================
# OSLin - First Login Setup (Sway/Wayland version)
# Runs on login to ensure configs are applied
# ============================================
set -u

# Wait for the session to be ready
sleep 3

# Only run as regular user (not root)
if [ "$(id -u)" -eq 0 ]; then
    exit 0
fi

CONFIG_DIR="$HOME/.config"

# ---------- 1. Ensure Sway config exists ----------
if [ ! -f "$CONFIG_DIR/sway/config" ]; then
    echo "[OSLin] Installing Sway config for user..."
    mkdir -p "$CONFIG_DIR/sway"
    [ -f /etc/sway/config ] && cp /etc/sway/config "$CONFIG_DIR/sway/config"
fi

# ---------- 2. Ensure Waybar config exists ----------
if [ ! -f "$CONFIG_DIR/waybar/config" ]; then
    echo "[OSLin] Installing Waybar config..."
    mkdir -p "$CONFIG_DIR/waybar"
    [ -f /etc/xdg/waybar/config ] && cp /etc/xdg/waybar/config "$CONFIG_DIR/waybar/config"
    [ -f /etc/xdg/waybar/style.css ] && cp /etc/xdg/waybar/style.css "$CONFIG_DIR/waybar/style.css"
fi

# ---------- 3. Ensure Wofi config exists ----------
if [ ! -f "$CONFIG_DIR/wofi/config" ]; then
    echo "[OSLin] Installing Wofi config..."
    mkdir -p "$CONFIG_DIR/wofi"
    [ -f /etc/xdg/wofi/config ] && cp /etc/xdg/wofi/config "$CONFIG_DIR/wofi/config"
    [ -f /etc/xdg/wofi/style.css ] && cp /etc/xdg/wofi/style.css "$CONFIG_DIR/wofi/style.css"
fi

# ---------- 4. Ensure GTK theme is set (for XWayland apps) ----------
mkdir -p "$CONFIG_DIR/gtk-3.0"
if [ ! -f "$CONFIG_DIR/gtk-3.0/settings.ini" ]; then
    cat > "$CONFIG_DIR/gtk-3.0/settings.ini" <<'EOF'
[Settings]
gtk-theme-name=WhiteSur-Light
gtk-icon-theme-name=WhiteSur
gtk-font-name=Noto Sans 11
gtk-cursor-theme-name=WhiteSur-cursors
gtk-application-prefer-dark-theme=0
gtk-enable-animations=1
EOF
fi

mkdir -p "$CONFIG_DIR/gtk-4.0"
[ ! -f "$CONFIG_DIR/gtk-4.0/settings.ini" ] && cp "$CONFIG_DIR/gtk-3.0/settings.ini" "$CONFIG_DIR/gtk-4.0/settings.ini"

# ---------- 5. Mark first-login as done ----------
mkdir -p "$CONFIG_DIR/oslin"
date -u +"%Y-%m-%dT%H:%M:%SZ" > "$CONFIG_DIR/oslin/.first-login-done"

exit 0
