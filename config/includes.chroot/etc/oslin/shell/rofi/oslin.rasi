// ============================================
// OSLin Shell - Rofi Configuration (Spotlight launcher)
// ============================================

configuration {
    modes: [ drun, window, run ];
    font: "Noto Sans 13";
    show-icons: true;
    icon-theme: "WhiteSur";
    drun-display-format: "{name}";
    matching: "fuzzy";
    sort-method: "fuzzy";
    case-sensitive: false;
    cycle: true;
    lines: 8;
    columns: 2;
    line-padding: 8;
    padding: 24;
    sidebar-mode: false;
}

@theme "/dev/null"

* {
    bg:                  #0A2540;
    bg-alt:              #1E3A5F;
    fg:                  #FFFFFF;
    fg-alt:              #B0C4DE;
    accent:              #00B4D8;
    accent-alt:          #0078D4;
    border:              #2A4A6B;
    selected:            #0078D4;
    urgent:              #FF6B6B;
    bg-trans:            rgba(10, 37, 64, 0.85);
    bg-alt-trans:        rgba(30, 58, 95, 0.80);
    spacing:             8px;
    padding:             12px;
    border-width:        1px;
    border-radius:       14px;
}

window {
    width: 640px;
    height: 480px;
    background-color: @bg-trans;
    border: 1px solid @border;
    border-radius: @border-radius;
    padding: @padding;
    transparency: "real";
}

mainbox {
    spacing: @spacing;
    padding: @padding;
    children: [ inputbar, listview ];
}

inputbar {
    spacing: @spacing;
    padding: 16px 20px;
    background-color: @bg-alt-trans;
    border: 1px solid @border;
    border-radius: 12px;
    children: [ prompt, entry ];
}

prompt {
    text: "🔍";
    text-color: @accent;
}

entry {
    placeholder: "Search apps...";
    placeholder-color: @fg-alt;
    text-color: @fg;
}

listview {
    lines: 8;
    columns: 1;
    spacing: 4px;
    padding: 8px;
    background-color: transparent;
    border: 0px;
    dynamic: true;
    scrollbar: false;
}

element {
    orientation: horizontal;
    spacing: 12px;
    padding: 12px 16px;
    background-color: transparent;
    border-radius: 10px;
    cursor: pointer;
}

element-icon {
    size: 32px;
}

element-text {
    vertical-align: 0.5;
    text-color: @fg;
}

element selected.normal {
    background-color: @selected;
    text-color: @fg;
}

scrollbar {
    width: 0px;
}
