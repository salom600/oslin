# ============================================
# OSLin - tint2 Panel Configuration
# Bottom bar: taskbar + clock + tray + launcher
# Modern, transparent, glass effect
# ============================================

# ─── General ───
rounded = 0
border_width = 0
background_color = #0A2540 DD
border_color = #000000 00

background_color_hover = #1E3A5F DD
border_color_hover = #000000 00

background_color_pressed = #0078D4 DD
border_color_pressed = #000000 00

# ─── Panel ───
panel_items = LTS:c
panel_size = 100% 44
panel_margin = 0 0
panel_padding = 4 0 4
panel_background_id = 0
wm_menu = 1
panel_dock = 0
panel_position = bottom center horizontal
panel_layer = top
panel_monitor = all
primary_monitor_first = 1
autohide = 0
autohide_show_mtime = 500
autohide_hide_mtime = 500
strut_policy = follow_size
strut_size = 44

# ─── Taskbar ───
taskbar_mode = multi_desktop
taskbar_padding = 2 0 2
taskbar_background_id = 0
taskbar_active_background_id = 0

# ─── Taskbar ───
task_text = 1
task_icon = 1
task_centered = 1
task_maximum_size = 160 44
task_padding = 4 3 4
task_font = Noto Sans 10
task_font_color = #FFFFFF 100
task_active_font_color = #00B4D8 100
task_urgent_font_color = #FF6B6B 100
task_icon_asb = 70
task_active_icon_asb = 100
task_background_id = 0
task_active_background_id = 0
task_urgent_background_id = 0

# ─── Systray ───
systray_padding = 4 2 4
systray_background_id = 0
systray_sort = right2left
systray_icon_size = 20
systray_icon_asb = 100

# ─── Launcher ───
launcher_padding = 4 2 4
launcher_background_id = 0
launcher_icon_size = 24
launcher_item_app = /usr/share/applications/brave-browser.desktop
launcher_item_app = /usr/share/applications/thunar.desktop
launcher_item_app = /usr/share/applications/xfce4-terminal.desktop
launcher_item_app = /usr/share/applications/oslin-store.desktop
launcher_icon_theme = WhiteSur

# ─── Clock ───
time1_format = %H:%M
time1_font = Noto Sans Bold 12
time2_format = %a %d %b
time2_font = Noto Sans 9
clock_font_color = #FFFFFF 100
clock_padding = 8 4
clock_background_id = 0
clock_tooltip = %A, %B %d %Y
clock_lclick_command = zenity --calendar --title="Calendar" 2>/dev/null
clock_rclick_command = orage 2>/dev/null

# ─── Tooltip ───
tooltip_show_timeout = 0.3
tooltip_hide_timeout = 0.3
tooltip_padding = 4 4
tooltip_background_id = 0
tooltip_font_color = #FFFFFF 100
tooltip_font = Noto Sans 10

# ─── Separator ───
separator = |
separator_background_id = 0
separator_color = #1E3A5F 50
separator_padding = 4 0

# ─── Button (no buttons — clean look) ───
button_background_id = 0
button_font = Noto Sans 10
button_font_color = #FFFFFF 100
button_padding = 4 0 4

# ─── Mouse actions ───
mouse_middle = none
mouse_right = close
mouse_scroll_up = toggle
mouse_scroll_down = iconify

# ─── Battery (if present) ───
battery_low_status = 15
battery_low_cmd = notify-send -u critical "Battery Low" "Connect charger" 2>/dev/null
bat1_font = Noto Sans 9
bat2_font = Noto Sans 9
battery_font_color = #FFFFFF 100
battery_padding = 4 4
battery_background_id = 0
battery_hide = 0

# ─── Volume (if pulseaudio) ───
voltt_font = Noto Sans 9
volume_font_color = #FFFFFF 100
