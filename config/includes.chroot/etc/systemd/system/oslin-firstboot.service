[Unit]
Description=OSLin First Boot Setup (non-blocking)
After=graphical.target
Wants=graphical.target
ConditionPathExists=!/etc/oslin/.firstboot-done

[Service]
Type=oneshot
ExecStart=/usr/local/bin/oslin-firstboot
StandardOutput=journal+console
StandardError=journal+console
RemainAfterExit=yes
# Never block boot
SuccessExitStatus=0 1 2
TimeoutStartSec=60

[Install]
WantedBy=graphical.target
